local function updateafk()
    if Toggles.antiafk.Value then
        for _, c in next, getconnections(lp.Idled) do
            c:Disable()
        end
    else
        for _, c in next, getconnections(lp.Idled) do
            c:Enable()
        end
    end
end

Toggles.antiafk:OnChanged(updateafk)
task.spawn(updateafk)

local cutscenebackup = nil
local assetsfolder = rf:WaitForChild("Assets", 5)

local function updatecutscenes()
    local shouldDestroy = Toggles.nocutscenes.Value
    if shouldDestroy then
        if assetsfolder and assetsfolder:FindFirstChild("Cutscenes") then
            cutscenebackup = assetsfolder.Cutscenes:Clone()
            assetsfolder.Cutscenes:Destroy()
        end
    else
        if cutscenebackup and assetsfolder and not assetsfolder:FindFirstChild("Cutscenes") then
            local restored = cutscenebackup:Clone()
            restored.Parent = assetsfolder
        end
    end
end

Toggles.nocutscenes:OnChanged(updatecutscenes)
task.spawn(updatecutscenes)

local badgeavatar = 4414076328730650
local badgerelude = 154204790800271
local badgehunter = 3483144763925839

local initA, initR, initH = false, false, false
task.spawn(function()
    pcall(function() initA = bs:UserHasBadgeAsync(lp.UserId, badgeavatar) end)
    pcall(function() initR = bs:UserHasBadgeAsync(lp.UserId, badgerelude) end)
    pcall(function() initH = bs:UserHasBadgeAsync(lp.UserId, badgehunter) end)
end)

local isKicking = false

local function checkbadges()
    local a, r, h = false, false, false
    pcall(function() a = bs:UserHasBadgeAsync(lp.UserId, badgeavatar) end)
    pcall(function() r = bs:UserHasBadgeAsync(lp.UserId, badgerelude) end)
    pcall(function() h = bs:UserHasBadgeAsync(lp.UserId, badgehunter) end)
    return a, r, h
end

local function triggerkick()
    if isKicking or not Toggles.kickafter.Value then return end
    isKicking = true

    task.wait(2.5)

    local curA, curR, curH = checkbadges()

    local newA = curA and not initA
    local newR = curR and not initR
    local newH = curH and not initH

    local reason = ""
    if newA and newR then
        reason = "you got the avatar and relude glove"
    elseif newA and newH then
        reason = "you got the avatar and hunter glove"
    elseif newA then
        reason = "you got the avatar glove"
    elseif newR then
        reason = "you got the relude glove"
    elseif newH then
        reason = "you got the hunter glove"
    end

    if reason == "" then
        if curA and curR and (newA or newR) then
            reason = "you got the avatar and relude glove"
        elseif curA and curH and (newA or newH) then
            reason = "you got the avatar and hunter glove"
        elseif newR or (curR and not initR) then
            reason = "you got the relude glove"
        elseif newH or (curH and not initH) then
            reason = "you got the hunter glove"
        elseif newA or (curA and not initA) then
            reason = "you got the avatar glove"
        end
    end

    if reason ~= "" then
        lp:Kick(reason)
    else
        lp:Kick("you chose the wrong one / you have all the gloves")
    end
end

