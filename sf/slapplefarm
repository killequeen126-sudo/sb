task.spawn(function()
    task.wait(1.5)
    char = getchar()
    hrp = char.HumanoidRootPart

    if not char:FindFirstChild("entered") then
        local attempts = 0
        repeat
            task.wait(0.2)
            firetouchinterest(hrp, workspace.Lobby.Teleport1, 0)
            firetouchinterest(hrp, workspace.Lobby.Teleport1, 1)
            attempts = attempts + 1
        until char:FindFirstChild("entered") or attempts > 15
    end

    task.wait(0.5)

    if workspace:FindFirstChild("Arena") and workspace.Arena:FindFirstChild("island5") and workspace.Arena.island5:FindFirstChild("Slapples") then
        for _, v in ipairs(workspace.Arena.island5.Slapples:GetDescendants()) do
            if v.Name == "Glove" and v:FindFirstChildWhichIsA("TouchTransmitter") then
                firetouchinterest(hrp, v, 0)
                firetouchinterest(hrp, v, 1)
            end
        end
    end

    task.wait(1.5)
    subtitle.Text = "hopping to new server"
    if not hoppingstatus then
        hop()
    end
end)
